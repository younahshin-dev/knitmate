# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env는 제출 ZIP에 넣지 마세요)

# [선택] LLM 제공자: azure(기본) | gemini (Google Gemini) | openai (OpenAI 호환 API)
LLM_PROVIDER=azure

# ── LLM_PROVIDER=azure ─────────────────────────────────────────
# [필수] Azure OpenAI 채팅 모델 (GPT-4o 배포)
AOAI_API_KEY=
AOAI_ENDPOINT=https://<리소스명>.openai.azure.com/
AOAI_DEPLOY_GPT4O=
AOAI_API_VERSION=2024-10-21

# [선택] Azure OpenAI 임베딩 배포명 (예: text-embedding-3-small). 없으면 로컬 TF-IDF 검색으로 자동 대체
AOAI_DEPLOY_EMBEDDING=
# AOAI_EMBEDDING_API_VERSION=2024-10-21

# ── LLM_PROVIDER=openai (OpenAI 호환 API) ──────────────────────
# [필수] LLM_API_KEY, LLM_MODEL / LLM_BASE_URL을 비우면 OpenAI 공식 API
# [선택] EMBEDDING_MODEL — 없으면 로컬 TF-IDF 검색으로 자동 대체
# 도안 변환은 Function Calling이 필요하고, 이미지·스캔 PDF는 비전 지원 모델이 필요합니다.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=

# 예시) Google Gemini (무료 등급, https://aistudio.google.com/apikey)
#   Gemini는 LLM_PROVIDER=gemini 로 전용 클라이언트를 쓰세요 (openai 호환 방식은 도구 호출이 이어지는 코치에서 실패)
#   무료 등급은 모델별 하루 호출 수 제한이 있습니다.
# LLM_PROVIDER=gemini
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001

# 예시) Groq (무료 등급, 임베딩 없음 → TF-IDF 사용)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# 예시) Ollama (로컬, 키 불필요 — 아무 값이나 입력)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text

# [선택] YouTube Data API v3 키. 없으면 큐레이션 목록 + YouTube 검색 링크 사용
YOUTUBE_API_KEY=

# [선택] Langfuse 트레이싱
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
